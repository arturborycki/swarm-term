{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers serves dist/ as static assets. worker/index.ts runs only for the
  // paths in run_worker_first: the forms, download counting and the update feed.
  "name": "swarm-term",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "swarm-term.com", "custom_domain": true },
    { "pattern": "www.swarm-term.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/download/*", "/releases/latest.json"]
  },
  // Issue reports. A Worker may only mail verified Email Routing destinations, so
  // it sends to the one info@swarm-term.com forwards to, kept out of the
  // repository as the secret REPORT_TO (`npx wrangler secret put REPORT_TO`).
  "send_email": [{ "name": "REPORTS" }],
  // Download and update-check totals, and release-news subscribers (migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "swarm-site", "database_id": "88d3e7ee-7a84-4f85-ab60-655d87ebb856" }
  ],
  // Per visitor address: 3 sent reports or subscriptions a minute.
  "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
