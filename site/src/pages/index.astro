---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/hero.png';
import { DMG, VERSION, linuxTarball } from '../site';

const features = [
  {
    icon: 'persist',
    title: 'Tabs that keep running',
    body: 'Close the window, quit the app, restart the daemon. Builds, servers and shells carry on, and reopen with their output and blocks.',
  },
  {
    icon: 'remote',
    title: 'This Mac or any server',
    body: 'Connect to Linux and macOS hosts over your own ssh setup. Swarm installs its daemon there and reconnects after sleep or a dropped network.',
  },
  {
    icon: 'blocks',
    title: 'A modern terminal on top',
    body: 'Built on Warp’s open-source engine: commands as blocks, a real text editor for input, completions. One panel per session, splits for more.',
  },
  {
    icon: 'update',
    title: 'Updates without restarts',
    body: 'A new version moves running sessions to its new session process in place. Same process, same output, nothing restarted.',
  },
  {
    icon: 'scroll',
    title: 'Scrollback that remembers',
    body: '16 MB per session in memory. Optionally keep far more on disk, encrypted with a key only that session holds.',
  },
  {
    icon: 'cli',
    title: 'Scriptable from anywhere',
    body: 'swarmctl lists, attaches, renames and dumps sessions, on this Mac or on any host you can ssh to.',
  },
];

const faq = [
  {
    q: 'Is Swarm a tmux alternative?',
    a: 'It solves the same problem, sessions that survive closing the terminal or losing the connection, without a multiplexer inside your terminal. Each session belongs to a background daemon, swarmd, and Swarm shows it as a native tab with its own scrollback, command blocks and completions. You can still run tmux inside a Swarm session if you like.',
  },
  {
    q: 'What happens to my sessions when I quit Swarm?',
    a: 'They keep running. Shells, builds and servers belong to swarmd, not to the app, so quitting Swarm, closing the window or updating it leaves them alone. When you open Swarm again, each tab reattaches with its output.',
  },
  {
    q: 'Does Swarm keep SSH sessions alive on remote servers?',
    a: 'Yes. Swarm connects to Linux and macOS hosts through your own ssh configuration and keys, installs its daemon there, and runs your sessions on the server. If your Mac sleeps or the network drops, the sessions keep running and Swarm reconnects to them.',
  },
  {
    q: 'Can I use it from the command line or in scripts?',
    a: 'Yes. swarmctl lists, starts, attaches to, renames, dumps and ends sessions, on this Mac or on any host with --host.',
  },
  {
    q: 'Is Swarm free, and what does it need?',
    a: `Swarm is a free download for macOS 13 Ventura or later, on Apple silicon and Intel. The app is signed and notarized by Apple and updates itself. Remote hosts can run Linux or macOS. The current version is ${VERSION}.`,
  },
  {
    q: 'Is Swarm based on Warp?',
    a: 'Swarm is built on Warp’s open-source terminal engine, so it has Warp’s command blocks and input editor. It needs no Warp account or Warp cloud services, and adds what Warp doesn’t have: sessions owned by a daemon that outlive the app, on your Mac and on servers.',
  },
];

const software = {
  '@type': 'SoftwareApplication',
  name: 'Swarm',
  alternateName: 'swarm-term',
  description:
    'A macOS terminal where every tab is a persistent session owned by a background daemon, on your Mac or on a remote server over SSH.',
  url: 'https://swarm-term.com/',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Terminal emulator',
  operatingSystem: 'macOS 13 or later',
  softwareVersion: VERSION,
  downloadUrl: DMG,
  image: 'https://swarm-term.com/og.png',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: features.map((f) => f.title),
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

---

<Base
  title="Swarm — macOS terminal with persistent sessions, local and over SSH"
  description="Swarm is a free macOS terminal with persistent sessions. Quit the app or lose Wi-Fi and your shells, builds and SSH sessions keep running, like tmux, in native tabs."
  jsonLd={[software, faqPage]}
>
  <section class="hero frame">
    <p class="label"><span class="live">●</span> v{VERSION} <span class="dim">·</span> macOS 13+ <span class="dim">·</span> apple silicon + intel</p>
    <h1>Close the window.<br />The work keeps <span class="accent">running<span class="cursor" aria-hidden="true"></span></span></h1>
    <p class="lede">
      Swarm is a macOS terminal with persistent sessions: every tab is owned by a small background daemon, on your Mac
      or on a server over SSH. Quit the app, lose Wi-Fi, update it: your shells, builds and servers are still there
      when you come back.
    </p>
    <div class="actions">
      <a class="btn primary" href={DMG}>
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 4.9c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.5-.7.8-1.2 2-1.1 3.1 1.1.1 2.3-.6 3-1.4z"/></svg>
        Download for macOS
      </a>
      <a class="btn" href="/docs/">Read the docs</a>
    </div>
    <div class="cmd" aria-label="Command line client">
      <span class="prompt">$</span>
      <code>swarmctl ls --host my-server</code>
      <button class="copy" data-copy="swarmctl ls --host my-server">copy</button>
    </div>
  </section>

  <section class="frame shot">
    <figure class="fig">
      <div class="fig-bar"><span>[ fig. 1 · four sessions, one window ]</span><span>swarm {VERSION}</span></div>
      <Image src={hero} alt="The Swarm app: a sidebar of four sessions (swarm-term, release, web, notes) beside a terminal showing git log, a passing cargo test and swarmctl ls." widths={[800, 1280, 1920, 2560]} sizes="(max-width: 1200px) 100vw, 1120px" loading="eager" />
    </figure>
  </section>

  <section class="section">
    <div class="frame">
      <p class="label"># how it works <span class="dim">[ three processes ]</span></p>
      <h2>The window is just a view</h2>
      <p class="lede">
        Shells don't belong to the app. Each one lives in its own small process under <code class="mono">swarmd</code>,
        which keeps its output. The app, or <code class="mono">swarmctl</code>, attaches and detaches as it likes.
      </p>
      <div class="diagram" role="img" aria-label="Swarm.app and swarmctl connect to swarmd on this Mac directly and to swarmd on a server over ssh; each swarmd owns one process per session, which owns the shell.">
        <div class="tier">
          <div class="box client"><span class="t">Swarm.app</span><span class="s">windows, tabs, blocks</span></div>
          <div class="box client"><span class="t">swarmctl</span><span class="s">scripts, ssh, CI</span></div>
        </div>
        <div class="links"><span>local socket</span><span>ssh</span></div>
        <div class="tier hosts">
          <div class="host">
            <p class="hostname">this mac</p>
            <div class="box daemon"><span class="t">swarmd</span><span class="s">sessions, scrollback</span></div>
            <div class="shims"><span>shim → zsh</span><span>shim → cargo</span><span>shim → vim</span></div>
          </div>
          <div class="host">
            <p class="hostname">my-server</p>
            <div class="box daemon"><span class="t">swarmd</span><span class="s">same, on Linux</span></div>
            <div class="shims"><span>shim → bash</span><span>shim → tail -f</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="frame">
      <p class="label"># features <span class="dim">[ 6 ]</span></p>
      <h2>Built for work that takes a while</h2>
      <div class="grid">
        {features.map((f) => (
          <article class="cell">
            <span class={`glyph ${f.icon}`} aria-hidden="true"></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="frame split">
      <div>
        <p class="label"># cli <span class="dim">[ swarmctl ]</span></p>
        <h2>Every session, one command away</h2>
        <p class="lede">
          The same sessions the app shows, from any terminal or script. Add <code class="mono">--host</code> to reach a
          server's sessions through your ssh config, keys and jump hosts.
        </p>
        <a class="btn" href="/docs/#swarmctl">swarmctl reference</a>
      </div>
      <pre class="term" aria-label="Example swarmctl session"><span class="p">$</span> swarmctl ls --host build-box
<span class="d">ID          NAME     STATE          ACTIVE</span>
01M6EKBXJS  release  running cargo  now
01M6EKBXK8  logs     running tail   3s
01M6EKBXKQ  shell    idle           2h

<span class="p">$</span> swarmctl attach release --host build-box
<span class="d">   Compiling swarmd v{VERSION}</span>
<span class="ok">    Finished</span> release [optimized] in 41.2s
<span class="d">[ctrl-\ detaches; the build keeps going]</span>

<span class="p">$</span> swarmctl dump release &gt; build.log</pre>
    </div>
  </section>

  <section class="section">
    <div class="frame">
      <p class="label"># faq <span class="dim">[ {faq.length} ]</span></p>
      <h2>Questions</h2>
      <div class="faq">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="frame">
      <p class="label"># get it <span class="dim">[ v{VERSION} ]</span></p>
      <h2 id="download">Download Swarm {VERSION}</h2>
      <div class="downloads">
        <article class="dl">
          <p class="dl-kind">the app <span class="dim">· macOS</span></p>
          <h3>Swarm for Mac</h3>
          <p>Universal app for Apple silicon and Intel, macOS 13 Ventura or later. Signed and notarized by Apple, and it installs its own updates.</p>
          <div class="actions">
            <a class="btn primary" href={DMG}>Download Swarm-{VERSION}.dmg</a>
            <a class="btn" href="/changelog/">What's new</a>
          </div>
        </article>
        <article class="dl">
          <p class="dl-kind">the server <span class="dim">· linux</span></p>
          <h3>swarmd for Linux servers</h3>
          <p>
            Optional: the app installs <code>swarmd</code> on a server when you connect. Download it to set servers up
            yourself or to use <code>swarmctl</code> on Linux. Static builds, no root needed.
          </p>
          <div class="actions">
            <a class="btn" href={linuxTarball('x86_64')}>x86_64 .tar.gz</a>
            <a class="btn" href={linuxTarball('aarch64')}>aarch64 (ARM) .tar.gz</a>
          </div>
          <div class="cmd small">
            <span class="prompt">$</span>
            <code>curl -fsSL {linuxTarball('x86_64')} | tar -xz -C ~/.local/share/swarm/bin</code>
            <button class="copy" data-copy={`mkdir -p ~/.local/share/swarm/bin && curl -fsSL ${linuxTarball('x86_64')} | tar -xz -C ~/.local/share/swarm/bin`}>copy</button>
          </div>
          <a class="more" href="/docs/#server-install">Install instructions and checksums →</a>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 48px;
    display: grid;
    gap: 24px;
  }

  .accent {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.08em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .shot {
    padding-bottom: 96px;
  }

  .diagram {
    margin-top: 48px;
    font-family: var(--mono);
    display: grid;
    gap: 0;
  }

  .tier {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .box {
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    border-radius: 8px;
    padding: 14px 16px;
    display: grid;
    gap: 2px;
  }

  .box .t {
    font-size: 15px;
    font-weight: 500;
  }

  .box .s {
    font-size: 12px;
    color: var(--ink-3);
  }

  .box.daemon {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    font-size: 11px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .links span {
    border-left: 1px dashed var(--line-strong);
    margin-left: 24px;
    padding: 18px 0 18px 12px;
  }

  .host {
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
    padding: 12px;
    display: grid;
    gap: 10px;
  }

  .hostname {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .shims {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .shims span {
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 4px 8px;
    color: var(--ink-2);
    background: var(--bg-raised);
  }

  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  @media (max-width: 899px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .tier,
    .links {
      grid-template-columns: minmax(0, 1fr);
    }
    .links span:last-child {
      display: none;
    }
  }

  .faq {
    margin-top: 32px;
    border-top: 1px solid var(--line-strong);
    max-width: 880px;
  }

  .faq details {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-size: 17px;
    font-weight: 500;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-family: var(--mono);
    color: var(--ink-3);
  }

  .faq details[open] summary::after {
    content: '−';
  }

  .faq details p {
    margin: 0 0 20px;
    color: var(--ink-2);
    max-width: 720px;
  }

  .cell {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 28px 24px 32px;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .cell p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
  }

  /* Small geometric glyphs, one per feature, drawn in CSS so they follow the theme. */
  .glyph {
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    position: relative;
  }

  .glyph.persist::after {
    content: '';
    position: absolute;
    inset: 6px 6px auto auto;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .glyph.remote {
    border-radius: 50%;
  }

  .glyph.remote::after {
    content: '';
    position: absolute;
    inset: 11px -6px auto -6px;
    border-top: 1.5px dashed var(--accent);
  }

  .glyph.blocks::before,
  .glyph.blocks::after {
    content: '';
    position: absolute;
    left: 5px;
    right: 5px;
    height: 4px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.6;
  }

  .glyph.blocks::before {
    top: 6px;
  }

  .glyph.blocks::after {
    bottom: 6px;
  }

  .glyph.update::after {
    content: '↻';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent);
    font-size: 16px;
  }

  .glyph.scroll::after {
    content: '';
    position: absolute;
    top: 5px;
    bottom: 5px;
    right: 5px;
    width: 3px;
    border-radius: 2px;
    background: var(--accent);
  }

  .glyph.cli::after {
    content: '❯';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 13px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 48px;
    align-items: center;
  }

  .split > div {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  @media (max-width: 899px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cta .frame {
    display: grid;
    gap: 20px;
  }

  .downloads {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 899px) {
    .downloads {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    align-content: start;
    padding: 28px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    min-width: 0;
  }

  @media (max-width: 599px) {
    .dl {
      padding: 20px 16px;
    }
  }

  .dl h3 {
    margin: 0;
    font-size: 22px;
  }

  .dl > p {
    margin: 0;
    color: var(--ink-2);
  }

  .dl-kind {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: lowercase;
    color: var(--ink-3) !important;
  }

  .dl .cmd.small {
    max-width: 100%;
    background: var(--bg);
  }

  .dl .cmd.small code {
    min-width: 0;
    font-size: 12px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .more {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  .note {
    font-size: 14px;
    color: var(--ink-3);
    margin: 0;
    max-width: 640px;
  }

  code.mono {
    font-size: 0.92em;
  }
</style>
