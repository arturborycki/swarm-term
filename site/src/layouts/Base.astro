---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Hive from '../components/Hive.astro';
import NewsSignup from '../components/NewsSignup.astro';
import RepoLink from '../components/RepoLink.astro';
import { APP_REPO, DMG, REPO_PUBLIC, VERSION } from '../site';
import StarLink from '../components/StarLink.astro';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (confirmation and error pages). */
  noindex?: boolean;
  /** Extra schema.org objects for this page, besides the site-wide WebSite. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL('https://swarm-term.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const structured = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Swarm', url: site.href },
  ...jsonLd.map((item) => ({ '@context': 'https://schema.org', ...item })),
];
const path = Astro.url.pathname;
const nav = [
  { href: '/docs/', label: 'docs' },
  { href: '/changelog/', label: 'changelog' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Swarm" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Swarm: the macOS terminal whose sessions keep running" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <meta name="theme-color" content="#101217" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f1" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <div class="margin-label left" aria-hidden="true">swarm · terminal · {VERSION}</div>
    <div class="margin-label right" aria-hidden="true">sessions · that · outlive · windows</div>

    <header class="top">
      <div class="frame bar">
        <a href="/" class="brand" aria-label="Swarm home">
          <Hive size={26} />
          <span>swarm</span>
        </a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} class:list={['navlink', { here: path.startsWith(item.href) }]}>{item.label}</a>
          ))}
          <RepoLink class="navlink">github</RepoLink>
          <StarLink class="navlink" short />
          <a class="btn primary small" href={DMG}>Download</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="frame cols">
        <div class="brandcol">
          <a href="/" class="brand" aria-label="Swarm home"><Hive size={30} /><span>swarm</span></a>
          <p>A terminal whose tabs are sessions that keep running, on your Mac or on a server.</p>
          <NewsSignup source="footer" />
        </div>
        <div>
          <p class="head">product</p>
          <a href={DMG}>download for mac</a>
          <a href="/#download">linux server</a>
          <a href="/docs/">docs</a>
          <a href="/changelog/">changelog</a>
          <a href="/news/">release news</a>
        </div>
        <div>
          <p class="head">project</p>
          <RepoLink>github</RepoLink>
          <StarLink />
          {REPO_PUBLIC && <a href={APP_REPO}>app source</a>}
          <RepoLink path="/blob/main/docs/DESIGN.md">design</RepoLink>
          <RepoLink path="/blob/main/SECURITY.md">security</RepoLink>
        </div>
        <div>
          <p class="head">help</p>
          <a href="/report/">report an issue</a>
          <a href="/docs/#troubleshooting">troubleshooting</a>
          <a href="/privacy/">privacy</a>
        </div>
      </div>
      <div class="frame legal">
        <span>© 2026 swarm-term</span>
        <span>app: AGPL-3.0 · daemon: MIT or Apache-2.0 · open source on GitHub</span>
      </div>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            const label = button.textContent;
            button.textContent = 'copied';
            setTimeout(() => (button.textContent = label), 1400);
          } catch {
            // Clipboard access can be refused; the command stays selectable.
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  nav :global(.navlink) {
    font-family: var(--mono);
    font-size: 13px;
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a.navlink:hover,
  nav a.navlink.here {
    color: var(--ink);
  }

  .btn.small {
    padding: 8px 12px;
    font-size: 12px;
  }

  @media (max-width: 560px) {
    nav {
      gap: 14px;
    }
    nav :global(.navlink:nth-child(2)),
    nav :global(.navlink:nth-child(3)) {
      display: none;
    }
  }

  .margin-label {
    position: fixed;
    top: 50%;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
    z-index: 0;
    pointer-events: none;
  }

  .margin-label.left {
    left: calc(50% - var(--frame) / 2 - 22px);
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  .margin-label.right {
    left: calc(50% + var(--frame) / 2 + 22px);
    transform: translate(-50%, -50%) rotate(90deg);
  }

  @media (max-width: 1300px) {
    .margin-label {
      display: none;
    }
  }

  .foot {
    border-top: 1px solid var(--line);
    padding: 56px 0 28px;
    font-family: var(--mono);
    font-size: 13px;
  }

  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 719px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brandcol {
      grid-column: 1 / -1;
    }
  }

  /* The link columns. :global(a): links drawn by components (RepoLink,
     StarLink) carry their own scope, so a scoped `.cols a` would miss them;
     the brand column (with the news form's inline links) is left alone. */
  .cols > div:not(.brandcol) > :global(a),
  .cols > div:not(.brandcol) > :global(.repo-soon) {
    display: block;
    color: var(--ink-2);
    text-decoration: none;
    padding: 3px 0;
    overflow-wrap: anywhere;
  }

  .cols > div:not(.brandcol) > :global(a.star) {
    display: flex;
  }

  .cols > div:not(.brandcol) > :global(a:hover) {
    color: var(--ink);
  }

  .brandcol {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .brandcol > p {
    margin: 0;
    color: var(--ink-2);
    max-width: 300px;
    font-family: var(--sans);
    font-size: 14px;
  }

  .head {
    color: var(--ink-3);
    margin: 0 0 8px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 48px;
    color: var(--ink-3);
    font-size: 12px;
  }
</style>
